# =============================================================================
# Hostinger public_html/.htaccess — POORA FILE (copy-paste root par)
# =============================================================================
# Problem: /api/* par Angular HTML aata hai = ye file missing ya API rule SPA se UPAR nahi
# =============================================================================

<IfModule mod_negotiation.c>
  Options -MultiViews
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # --- API (PEHLE — Angular se pehle zaroor) ---
  # Leading / substitution = document-root se path (shared hosting par zyada reliable)
  RewriteCond %{REQUEST_URI} ^/api/ [NC]
  RewriteRule ^api(?:/(.*))?$ /api/public/index.php [L,QSA]

  # --- Angular SPA ---
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>
