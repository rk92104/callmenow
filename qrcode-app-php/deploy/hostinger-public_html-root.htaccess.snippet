# =============================================================================
# Hostinger: public_html/.htaccess — API block (TOP par, Angular se PEHLE)
# =============================================================================
<IfModule mod_negotiation.c>
  Options -MultiViews
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  RewriteCond %{REQUEST_URI} ^/api/ [NC]
  RewriteRule ^api(?:/(.*))?$ /api/public/index.php [L,QSA]
</IfModule>
# =============================================================================
# Uske NICHE Angular SPA rules paste karo
# =============================================================================
